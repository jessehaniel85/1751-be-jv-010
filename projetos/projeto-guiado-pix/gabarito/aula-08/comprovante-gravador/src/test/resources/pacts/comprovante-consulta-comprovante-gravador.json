{
  "consumer": {
    "name": "comprovante-consulta"
  },
  "interactions": [
    {
      "description": "busca de comprovante por id inexistente",
      "providerStates": [
        {
          "name": "comprovante 0000... n\u00E3o existe"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/comprovantes/00000000-0000-0000-0000-000000000000"
      },
      "response": {
        "status": 404
      }
    },
    {
      "description": "busca de comprovante por id existente",
      "providerStates": [
        {
          "name": "comprovante 7f3a... existe e est\u00E1 gravado"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/comprovantes/7f3a0e4c-1d2b-4c8a-9f01-2a3b4c5d6e7f"
      },
      "response": {
        "body": {
          "chavePix": "joao@pix.com",
          "dataHora": "2000-01-31T11:00:00",
          "id": "7f3a0e4c-1d2b-4c8a-9f01-2a3b4c5d6e7f",
          "status": "GRAVADO",
          "valor": 150.0
        },
        "generators": {
          "body": {
            "$.dataHora": {
              "format": "yyyy-MM-dd'T'HH:mm:ss",
              "type": "DateTime"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.chavePix": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.dataHora": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ss",
                  "match": "timestamp"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "GRAVADO|ACEITO"
                }
              ]
            },
            "$.valor": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.6.14"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "comprovante-gravador"
  }
}
